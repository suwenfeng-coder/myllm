spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/myllm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: your-mysql-password
    driver-class-name: com.mysql.cj.jdbc.Driver
  neo4j:
    uri: bolt://127.0.0.1:7687
    authentication:
      username: neo4j
      password: ${NEO4J_PASSWORD}

vector:
  datasource:
    url: jdbc:postgresql://127.0.0.1:5434/myllm
    username: pgvector
    password: pgvector

graph:
  enabled: true
  database: neo4j
  indexing:
    enabled: true
    entity-extraction-enabled: true
    entity-extraction-version: entity-v1
    entity-extraction-batch-size: 3
  retrieval:
    enabled: true
    shadow-mode: true
